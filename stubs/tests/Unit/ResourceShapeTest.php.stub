<?php

declare(strict_types=1);

/**
 * Pins the canonical `resources/` shape every ichava icon pack shares.
 *
 * Three of these assertions exist because of bugs the estate actually shipped,
 * all of them the same shape: a file nothing loads cannot fail loudly.
 *
 * - One pack shipped a verbatim copy of another pack's translation file --
 *   wrong product name, and the other pack's categories against its own. The
 *   enum comparison below is what makes a copied file fail.
 * - One pack's translation file claimed an MIT licence while its config.json
 *   said Commercial. Package facts belong in config.json alone.
 * - Every pack that kept `name` and `description` in both places had let them
 *   drift, because nothing read the translation copy.
 */
function {{snakeName}}_resources(): string
{
    return dirname(__DIR__, 2) . '/resources';
}

/** @return array<string, mixed> */
function {{snakeName}}_lang_lines(): array
{
    return require {{snakeName}}_resources() . '/lang/en/icons.php';
}

it(description: 'ships every path of the canonical resource shape', closure: function () {
    foreach ([
        'assets/svg/config.json',
        'assets/svg/files',
        'lang/en/icons.php',
        'views/components',
    ] as $path) {
        expect(file_exists({{snakeName}}_resources() . '/' . $path))->toBeTrue("missing resources/{$path}");
    }
});

it(description: 'does not name the translation group after the locale', closure: function () {
    // `lang/en/en.php` makes the group `en`, so every key reads
    // `<namespace>::en.name` with the locale doubled.
    expect(file_exists({{snakeName}}_resources() . '/lang/en/en.php'))->toBeFalse();
});

it(description: 'does not duplicate config.json metadata in english', closure: function () {
    // config.json is canonical for name and description -- IconRegistry reads
    // it. A copy here is a second source that nothing compares.
    expect({{snakeName}}_lang_lines())->not->toHaveKey('name')
        ->and({{snakeName}}_lang_lines())->not->toHaveKey('description');
});

it(description: 'states no licence in the translations', closure: function () {
    // Package facts belong in config.json. A licence string here is a claim
    // nothing validates, and one estate pack shipped the wrong one for months.
    expect({{snakeName}}_lang_lines())->not->toHaveKey('features');
});

it(description: 'matches every labelled group to its enum exactly', closure: function () {
    // Discovered, not hardcoded to `variants`.
    //
    // A pack that starts variant-style and later adds `categories` or `sets`
    // -- which three of the five estate packs did -- would otherwise keep a
    // test that checks `variants` and says nothing about the new group. That
    // is not hypothetical: icon-sets-twemoji shipped `sets`/`set_descriptions`
    // guarded by nothing at all, so its `Set` enum could drift from its
    // translations silently.
    //
    // The rule is the convention this estate already follows: a group `x` with
    // a sibling `x_descriptions` is a labelled group, and its keys must match
    // the cases of `Enums\<Studly singular of x>`.
    $lines = {{snakeName}}_lang_lines();
    $checked = 0;

    foreach (array_keys($lines) as $group) {
        if (! is_array($lines[$group])) {
            continue;
        }

        // `categories` -> `Category`, not `Categorie`. A bare rtrim('s') is
        // wrong for every -ies plural, and the estate has one: icon-sets-twemoji
        // ships a `Category` enum.
        $singular = str_ends_with($group, 'ies')
            ? substr($group, 0, -3) . 'y'
            : rtrim($group, 's');

        // The sibling key is SINGULAR: `variants` pairs with
        // `variant_descriptions`, `categories` with `category_descriptions`,
        // `sets` with `set_descriptions`. Pairing on the plural finds nothing
        // and the loop passes over every group in silence.
        $descriptions = $singular . '_descriptions';

        if (! isset($lines[$descriptions])) {
            continue;
        }

        $enum = '{{namespace}}\\Enums\\' . str_replace(
            ' ',
            '',
            ucwords(str_replace('_', ' ', $singular)),
        );

        expect(enum_exists($enum))->toBeTrue(
            "resources/lang/en/icons.php has a [{$group}] group but there is no {$enum}. "
            . 'A labelled group is only meaningful against an enum.',
        );

        $expected = array_column($enum::cases(), 'value');
        sort($expected);

        foreach ([$group, $descriptions] as $pair) {
            $actual = array_keys($lines[$pair]);
            sort($actual);

            expect($actual)->toBe(
                $expected,
                "resources/lang/en/icons.php [{$pair}] does not match {$enum}. "
                . 'Add the case and its label in the same change.',
            );
        }

        $checked++;
    }

    // Non-vacuous. A discovery loop that matches nothing passes in silence,
    // which is the failure this whole file exists to prevent.
    expect($checked)->toBeGreaterThan(0, 'no labelled group found in resources/lang/en/icons.php');
});

it(description: 'declares itself as this package in config.json', closure: function () {
    $config = json_decode(
        (string) file_get_contents({{snakeName}}_resources() . '/assets/svg/config.json'),
        true,
        flags: JSON_THROW_ON_ERROR,
    );

    expect($config['package']['name'])->toBe('{{packageName}}');
});

it(description: 'points metadata.repository at this package, not its upstream', closure: function () {
    // `metadata.repository` is THIS package's repository; the upstream's
    // identity lives in the `upstream` block. It had drifted to naming the
    // upstream in two estate packs and was blank in a third.
    $config = json_decode(
        (string) file_get_contents({{snakeName}}_resources() . '/assets/svg/config.json'),
        true,
        flags: JSON_THROW_ON_ERROR,
    );

    expect($config['metadata']['repository'])->toBe('https://github.com/{{packageName}}');
});

it(description: 'never points metadata.homepage at this package', closure: function () {
    // `metadata.homepage` is the UPSTREAM project's own site. It reaches a
    // consumer through IconRegistry and the browser API, but no frontend
    // renders it, so a wrong value is invisible until somebody reads the JSON.
    // The scaffolder emits none, because it cannot know the upstream; this
    // asserts the rule rather than a value, so it holds once you fill it in.
    $metadata = json_decode(
        (string) file_get_contents({{snakeName}}_resources() . '/assets/svg/config.json'),
        true,
        flags: JSON_THROW_ON_ERROR,
    )['metadata'];
    $homepage = $metadata['homepage'] ?? null;

    if ($homepage === null) {
        expect($metadata)->not->toHaveKey('homepage');

        return;
    }

    expect($homepage)
        ->not->toBe($metadata['repository'])
        ->and($homepage)->not->toContain('github.com/{{vendorKebab}}/');
});

it(description: 'ships no translations for an update command or an about block', closure: function () {
    // A pack registers no Artisan command, and core's about section reads the
    // registry, so strings for either are read by nothing.
    expect({{snakeName}}_lang_lines())->not->toHaveKey('commands')
        ->and({{snakeName}}_lang_lines())->not->toHaveKey('info');
});
