name: Code Quality

on:
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  pint:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    name: Laravel Pint

    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: 8.5
          extensions: dom, curl, libxml, mbstring, zip
          coverage: none

      - name: Test against the siblings' main
        # The committed constraints stay on the 0.1 line the released 0.1.0 satisfies
        # (SiblingConstraintsTest). CI aliases the siblings' main into that line so
        # this repository is tested against what it will ship beside, and restores
        # composer.json after the install so tests read the committed constraints.
        run: composer require "ichava/core:dev-main as 0.1.99" --no-update --no-interaction

      - name: Install dependencies
        run: composer update --prefer-stable --prefer-dist --no-interaction

      - name: Report the resolved siblings and restore composer.json
        run: |
          for p in ichava/core; do composer show "$p" | grep -E '^(name|versions|source) '; done
          git checkout -- composer.json

      - name: Run Laravel Pint
        run: composer pint

  phpstan:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    name: PHPStan

    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: 8.5
          extensions: dom, curl, libxml, mbstring, zip
          coverage: none

      - name: Test against the siblings' main
        # The committed constraints stay on the 0.1 line the released 0.1.0 satisfies
        # (SiblingConstraintsTest). CI aliases the siblings' main into that line so
        # this repository is tested against what it will ship beside, and restores
        # composer.json after the install so tests read the committed constraints.
        run: composer require "ichava/core:dev-main as 0.1.99" --no-update --no-interaction

      - name: Install dependencies
        run: composer update --prefer-stable --prefer-dist --no-interaction

      - name: Report the resolved siblings and restore composer.json
        run: |
          for p in ichava/core; do composer show "$p" | grep -E '^(name|versions|source) '; done
          git checkout -- composer.json

      - name: Run PHPStan
        run: composer analyse

  security:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    name: Security Audit

    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: 8.5
          extensions: dom, curl, libxml, mbstring, zip
          coverage: none

      - name: Test against the siblings' main
        # The committed constraints stay on the 0.1 line the released 0.1.0 satisfies
        # (SiblingConstraintsTest). CI aliases the siblings' main into that line so
        # this repository is tested against what it will ship beside, and restores
        # composer.json after the install so tests read the committed constraints.
        run: composer require "ichava/core:dev-main as 0.1.99" --no-update --no-interaction

      - name: Install dependencies
        run: composer update --prefer-stable --prefer-dist --no-interaction

      - name: Report the resolved siblings and restore composer.json
        run: |
          for p in ichava/core; do composer show "$p" | grep -E '^(name|versions|source) '; done
          git checkout -- composer.json

      - name: Security Audit
        run: composer audit

  actionlint:
    name: Workflow lint
    runs-on: ubuntu-latest
    timeout-minutes: 5

    # Nothing else reads these files until a tag is pushed. `release.yml` triggers
    # on `push: tags`, so without this a broken workflow is first observed as a
    # release that refuses to start -- after the decision to release has been made.
    #
    # A YAML parse is not a substitute. `yaml.safe_load` accepts a duplicate key
    # and silently keeps the last one, which is how a double-applied patch shipped
    # a step carrying `continue-on-error:` twice and still validated clean.
    # actionlint rejects what Actions rejects.
    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: actionlint
        uses: raven-actions/actionlint@3d39aea434753780c3b3d4a1a31c854b4dbf49d7 # v2.2.0
