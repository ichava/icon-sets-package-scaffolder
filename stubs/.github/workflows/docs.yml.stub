name: Docs

# Checks the shape of the docs/ tree. Like every workflow here since 2026-10-30
# it runs on every pull request: a path-filtered check never reports on a pull
# request it skips, so it could not be a required status check.
on:
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  shape:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    name: Docs shape

    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: '8.4'
          coverage: none

      - name: Install dependencies
        run: composer update --prefer-stable --prefer-dist --no-interaction

      - name: Assert the docs shape
        run: vendor/bin/pest --filter=DocsShapeTest
