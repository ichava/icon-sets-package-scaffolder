name: Docs

# Checks the shape of the docs/ tree. Like every workflow here since 2026-10-30
# it runs on every pull request: a path-filtered check never reports on a pull
# request it skips, so it could not be a required status check.
on:
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  shape:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    name: Docs shape

    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@eb7c497e18156a6bbabfef1d3a82760b9eda3962 # 2.40.0
        with:
          php-version: '8.4'
          coverage: none

      - name: Test against the siblings' main
        # The committed constraints stay on the 0.1 line the released 0.1.0 satisfies
        # (SiblingConstraintsTest). CI aliases the siblings' main into that line so
        # this repository is tested against what it will ship beside, and restores
        # composer.json after the install so tests read the committed constraints.
        run: composer require "ichava/core:dev-main as 0.1.99" --no-update --no-interaction

      - name: Install dependencies
        run: composer update --prefer-stable --prefer-dist --no-interaction

      - name: Report the resolved siblings and restore composer.json
        run: |
          for p in ichava/core; do composer show "$p" | grep -E '^(name|versions|source) '; done
          git checkout -- composer.json

      - name: Assert the docs shape
        run: vendor/bin/pest --filter=DocsShapeTest
